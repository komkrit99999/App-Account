generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MEMBER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum ImportStatus {
  PREVIEW
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  role         Role      @default(MEMBER)
  tier         Int       @default(1) // 1 = Basic, 2 = Standard, 3 = Advanced
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdCustomers Customer[]  @relation("CustomerCreatedBy")
  updatedCustomers Customer[]  @relation("CustomerUpdatedBy")
  imports          ImportLog[]
  exports          ExportLog[]
  loans            Loan[]
  invoicesCreated  Invoice[]   @relation("InvoiceCreatedBy")
  invoicesUpdated  Invoice[]   @relation("InvoiceUpdatedBy")
  auditLogs        AuditLog[]
}

model Customer {
  id   String @id @default(cuid())
  code String @unique // C00001, generated

  // ข้อมูลพื้นฐาน
  name            String
  phone           String?
  phoneNormalized String? // digits only, for search and duplicate checks
  email           String?
  address         String?
  note            String?

  // ช่องทางติดต่อ / ที่ทำงาน
  facebook       String?
  lineId         String?
  workplace      String?
  workplacePhone String?

  // ข้อมูลภาษี/บริษัท
  companyName   String?
  taxId         String? // 13 digits, checksum-validated
  isHeadOffice  Boolean @default(true)
  branchCode    String? // "00000" for head office, otherwise 5 digits
  contactPerson String?

  // ข้อมูลการเงิน — only selected for users with viewFinancial
  creditLimit        Decimal?
  paymentTermDays    Int?
  outstandingBalance Decimal  @default(0)

  createdById String
  createdBy   User      @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  tags      CustomerTag[]
  auditLogs AuditLog[]
  loans     Loan[]
  invoices  Invoice[]

  @@index([deletedAt, name])
  @@index([phoneNormalized])
  @@index([taxId, branchCode])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("slate")
  createdAt DateTime      @default(now())
  customers CustomerTag[]
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
}

model ImportLog {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  fileName   String
  fileSize   Int
  fileStored Boolean      @default(false) // original file kept in storage/imports/<id>
  status     ImportStatus @default(PREVIEW)

  headers       String // JSON string[]
  rows          String // JSON string[][] — staged on the server until commit, cleared after
  columnMapping String? // JSON { [columnIndex]: field }, saved on commit

  totalRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  failedRows  Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  errors    ImportRowError[]
  auditLogs AuditLog[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

model ImportRowError {
  id        String    @id @default(cuid())
  batchId   String
  batch     ImportLog @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int // as shown in Excel (header = row 1)
  message   String

  @@index([batchId])
}

// A loan to a customer. Interest is simple interest, quoted per year and capped
// at MAX_INTEREST_RATE_PER_YEAR (src/lib/loan.ts) — enforced on every write.
model Loan {
  id                  String     @id @default(cuid())
  customerId          String
  customer            Customer   @relation(fields: [customerId], references: [id])
  principal           Decimal // เงินต้น (บาท)
  interestRatePerYear Decimal // ร้อยละต่อปี
  interestDueDay      Int // ส่งดอกทุกวันที่ 1–31 (เดือนที่ไม่มีวันนั้น = วันสุดท้ายของเดือน)
  startDate           DateTime // วันที่ปล่อยกู้
  principalDueDate    DateTime? // กำหนดคืนเงินต้น, null = ไม่มีกำหนด
  status              LoanStatus @default(ACTIVE)
  note                String?
  closedAt            DateTime?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, interestDueDay])
  @@index([customerId])
}

// The seller shown on tax invoices. Single row (id = 1), edited by admins.
model CompanySettings {
  id            Int      @id @default(1)
  nameTh        String   @default("")
  nameEn        String?
  addressTh     String?
  addressEn     String?
  phone         String?
  email         String?
  lineId        String?
  facebook      String?
  taxId         String?
  isHeadOffice  Boolean  @default(true)
  branchCode    String? // 5 digits when not head office
  headerNote    String? // small line under the tax ID, e.g. "เอกสารออกเป็นชุด"
  invoicePrefix String   @default("INV")
  vatRate       Decimal  @default(7) // percent
  logoMime      String? // set when a logo is stored in storage/company/logo
  updatedAt     DateTime @updatedAt
}

// Tax invoice (ใบกำกับภาษี). Never deleted — cancelled instead, so numbers stay continuous.
// Buyer and seller details are copied in at issue time so later edits to the
// customer or company don't change an issued document.
model Invoice {
  id          String        @id @default(cuid())
  seq         Int           @unique // running number
  number      String        @unique // e.g. INV-102026/00001
  status      InvoiceStatus @default(ISSUED)
  issueDate   DateTime // date only (UTC midnight)
  dueDate     DateTime?
  salesperson String?
  paymentTerm String?
  remark      String?

  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  buyerName    String
  buyerBranch  String? // "สำนักงานใหญ่" / "สาขา 00001", shown after the name
  buyerAddress String?
  buyerTaxId   String?

  seller String // JSON snapshot of CompanySettings

  subtotal  Decimal
  vatRate   Decimal
  vatAmount Decimal
  total     Decimal

  items InvoiceItem[]

  createdById String
  createdBy   User      @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([issueDate])
  @@index([customerId])
  @@index([createdById, issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal
  unit        String?
  unitPrice   Decimal
  discount    Decimal @default(0)
  amount      Decimal

  @@index([invoiceId, position])
}

// Every customer export, with the filters that produced it
model ExportLog {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  fileName          String
  filters           String // JSON { q, tags: [{ id, name }] } at the time of the export
  rowCount          Int
  includesFinancial Boolean // false when the exporter lacked viewFinancial
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Who changed which customer, field by field
model AuditLog {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  action        AuditAction
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerLabel String // "C00001 ชื่อลูกค้า" at the time of the change
  changes       String // JSON [{ field, from, to }]
  importLogId   String? // set when the change came from a spreadsheet import
  importLog     ImportLog?  @relation(fields: [importLogId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([customerId, createdAt])
}
